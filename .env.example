DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DJANGO_CSRF_TRUSTED_ORIGINS=

# Register BACKEND_URL/api/v1/auth/oauth/{google,linkedin}/callback/ with the provider.
# FRONTEND_URL is where Django returns the browser after the server-side callback.
FRONTEND_URL=http://localhost:5500/ucc_skillshub_sign_in/code.html
BACKEND_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Use the Supabase session pooler (or direct connection) with SSL enabled.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
DATABASE_USE_TRANSACTION_POOLER=False

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFILE_BUCKET=profile-photos
SUPABASE_PROJECT_BUCKET=project-attachments
SUPABASE_COURSE_BUCKET=course-resources
SUPABASE_SIGNED_URL_TTL=300

DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

